# Example .env for penomoran-surat
# Default connection
database.default.DSN=
database.default.hostname=192.168.10.145
database.default.database=penomoran_db
database.default.username=sipd
# If password contains special chars, wrap with double quotes
database.default.password="s1n3rgh1@"
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.pConnect=false
database.default.DBDebug=true
database.default.charset=utf8mb4
database.default.DBCollat=utf8mb4_general_ci
database.default.port=3306
